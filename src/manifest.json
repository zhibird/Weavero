{
  "manifest_version": 2,
  "name": "Weavero for Obsidian",
  "version": "1.1.1",
  "description": "Two-way reading links between Zotero PDF locations and Obsidian, built on Weavero.",
  "author": "mjthoraval and contributors, zhibird",
  "homepage_url": "https://github.com/zhibird/Weavero",
  "applications": {
    "zotero": {
      "id": "weavero-obsidian@zhibird",
      "update_url": "https://github.com/zhibird/Weavero/releases/latest/download/update.json",
      "strict_min_version": "9.0",
      "strict_max_version": "10.0.*"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
